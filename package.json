{
  "private": true,
  "scripts": {
    "build": "npm run build:shader && npm run build:create-element-background && npm run build:create-document-background && npm run build:create-document && npm run build:replace-element-with-image",
    "build:shader": "esbuild web/ShaderRenderer.ts --bundle --format=iife --global-name=ShaderRenderer --outfile=generated/ShaderRenderer.js",
    "build:create-element-background": "esbuild web/CreateElementBackground.ts --bundle --format=iife --global-name=CreateElementBackground --outfile=generated/CreateElementBackground.js",
    "build:create-document-background": "esbuild web/CreateDocumentBackground.ts --bundle --format=iife --global-name=CreateDocumentBackground --outfile=generated/CreateDocumentBackground.js",
    "build:create-document": "esbuild web/CreateDocument.ts --bundle --format=iife --global-name=CreateDocument --outfile=generated/CreateDocument.js",
    "build:replace-element-with-image":  "esbuild web/ReplaceElementWithImage.ts --bundle --format=iife --global-name=ReplaceElementWithImage --outfile=generated/ReplaceElementWithImage.js"
},
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.0.0"
  }
}