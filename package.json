{
  "private": true,
  "scripts": {
    "build": "npm run build:render-shader && npm run build:document-functions",
    "build:render-shader": "esbuild web/ShaderRenderer.ts --bundle --format=iife --global-name=ShaderRenderer --outfile=generated/ShaderRenderer.js",
    "build:document-functions": "esbuild web/DocumentFunctions.ts --bundle --format=iife --global-name=DocumentFunctions --outfile=generated/DocumentFunctions.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.0.0"
  }
}